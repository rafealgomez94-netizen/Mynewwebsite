# ---------------------------------------------------------------------------
# Workspace Digital — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored; secrets never reach the browser.
# ---------------------------------------------------------------------------

# Public site configuration (safe to expose)
NEXT_PUBLIC_APP_NAME="Workspace Digital"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="rafealgomez94@gmail.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP="0774075285"
# Country dial code applied when the WhatsApp number above starts with a national 0
# (264 Namibia, 27 South Africa, 44 UK...). Numbers written in full international
# form (+264...) are used as-is.
NEXT_PUBLIC_SUPPORT_DIAL_CODE="264"
NEXT_PUBLIC_SUPPORT_PHONE="0888937524"

# Database
# Development default is a local SQLite file handled by node:sqlite.
# For production set DATABASE_URL to PostgreSQL and run db/schema.postgres.sql.
DATABASE_FILE="data/workspace-digital.db"
# DATABASE_URL="postgresql://user:password@host:5432/workspace_digital"

# Authentication — REQUIRED in production. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-development-only-secret-change-me"

# AI provider (OpenAI-compatible chat completions endpoint). Server-side only.
# When AI_API_KEY is empty the platform runs on the built-in deterministic
# analytics engine, which answers from verified business data and validates
# generated marketing content with the same knowledge base.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MAX_OUTPUT_TOKENS="1200"
AI_TIMEOUT_MS="45000"

# Email (verification + password reset). Without SMTP the app logs messages to
# the server console and surfaces tokens as development links.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Workspace Digital <no-reply@workspace.digital>"
SMTP_SECURE="false"

# File storage for uploaded knowledge-base documents
STORAGE_DRIVER="local"          # local | s3
STORAGE_LOCAL_DIR="data/storage"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# Payments. Never hard-code keys — the billing layer reads them here.
PAYMENT_PROVIDER="manual"       # manual | stripe
PAYMENT_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""

# Scheduled jobs. The appointment reminder routes are idempotent, so pointing a
# scheduler at them as often as you like never double-sends a reminder:
#   GET /api/cron/reminders?secret=$CRON_SECRET   (or Authorization: Bearer $CRON_SECRET)
# Leave empty to disable the platform-wide scheduler; the dashboard "send due
# reminders" button keeps working per workspace either way.
CRON_SECRET=""                    # generate with: openssl rand -hex 32

# Seed accounts (npm run db:seed). Change the passwords before any public demo.
SEED_ADMIN_EMAIL="admin@workspacedigital.app"
SEED_ADMIN_PASSWORD="AdminPassw0rd!"
SEED_OWNER_EMAIL="owner@test.local"
SEED_OWNER_PASSWORD="Str0ngPassw0rd!"
SEED_MANAGER_EMAIL="manager@test.local"
SEED_MANAGER_PASSWORD="ManagerPassw0rd!"
SEED_STAFF_EMAIL="staff@test.local"
SEED_STAFF_PASSWORD="StaffPassw0rd!"
SEED_BUSINESS_SLUG="windhoek-beauty-studio"
