{
  "name": "workspace-digital",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace Digital \u2014 AI-powered business operations platform (multi-tenant SaaS)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run smoke",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "photo:manager": "node scripts/set-manager-photo.mjs",
    "audit:clients": "node scripts/audit-client-contracts.mjs",
    "verify:extraction": "node scripts/verify-extraction.mjs",
    "probe:shapes": "node scripts/probe-response-shapes.mjs",
    "prod:check": "node scripts/prodcheck.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
